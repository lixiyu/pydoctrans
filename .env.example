# pydoctrans 配置
# 复制为 .env 后修改

# 最大并发 LO 进程数
LO_MAX_CONCURRENT=10

# LO 单次转换超时（秒）
LO_TIMEOUT=300

# 上传文件大小限制（MB）
MAX_FILE_SIZE_MB=50

# 优雅关闭最长等待（秒），0=不等待
GRACE_PERIOD=0

# 沙箱临时目录父路径
TMP_DIR=/tmp

# HTTP 服务绑定地址和端口
HOST=0.0.0.0
PORT=8000

# 日志级别: debug / info / warning / error
LOG_LEVEL=info

# URL 下载重试配置
DOWNLOAD_RETRIES=3
DOWNLOAD_RETRY_BASE_DELAY=1.0
DOWNLOAD_TIMEOUT=60

# LO 环境变量覆盖（通常不需要设，自动检测）
# LO_EXECUTABLE=/opt/libreoffice26.2/program/soffice
# LO_PROGRAM_DIR=/opt/libreoffice26.2/program
